<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="bw-engineview-parent" style="flex-grow: 1; width: 100%; height: 100%;">
        <ui:VisualElement name="bw-engineview-bgpanel" style="flex-grow: 1; width: 100%; height: 100%; justify-content: center; align-items: center; background-color: rgba(34, 34, 34, 0.85);">
            <ui:Label tabindex="-1" text="No engine selected" parse-escape-sequences="true" display-tooltip-when-elided="true" name="bw-engineview-msglbl" style="color: rgb(212, 212, 212);" />
        </ui:VisualElement>
        <ui:VisualElement name="bw-engineview-content" style="position: absolute; left: 0; top: 0; right: 0; bottom: 0;" />
    </ui:VisualElement>
</ui:UXML>
