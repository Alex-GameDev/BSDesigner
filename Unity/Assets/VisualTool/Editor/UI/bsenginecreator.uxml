<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <ui:VisualElement name="VisualElement" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.88); padding-top: 25px; padding-right: 25px; padding-bottom: 25px; padding-left: 25px;">
        <ui:ScrollView scroll-deceleration-rate="0,135" elasticity="0,1" mode="Horizontal" horizontal-scroller-visibility="Hidden" name="bw-enginecreation-list" style="justify-content: center;" />
        <ui:VisualElement name="bw-enginecreation-form" style="align-items: center; margin-top: 10px; margin-right: 10px; margin-bottom: 10px; margin-left: 10px;">
            <ui:TextField picking-mode="Ignore" label="Name" value="filler text" name="bw-enginecreation-name-tf" style="width: 100%; color: rgb(241, 241, 241);" />
            <ui:Button text="Create" parse-escape-sequences="true" display-tooltip-when-elided="true" name="bw-enginecreation-ok-btn" style="font-size: 18px; color: rgb(202, 202, 202); background-color: rgb(89, 89, 89); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px;" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
