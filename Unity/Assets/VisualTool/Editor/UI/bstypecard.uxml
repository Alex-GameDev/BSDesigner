<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <ui:VisualElement name="bw-card" style="flex-grow: 0; width: 200px; height: 300px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; background-color: rgb(40, 40, 40); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; align-items: center; padding-top: 5px; padding-right: 5px; padding-bottom: 5px; padding-left: 5px;">
        <ui:Label tabindex="-1" text="Title" parse-escape-sequences="true" display-tooltip-when-elided="true" name="bw-card-title" style="color: rgb(202, 202, 202); -unity-text-align: upper-center; -unity-font-style: bold; font-size: 16px;" />
        <ui:VisualElement name="bw-card-icon" style="flex-grow: 0; width: 50px; height: 50px; margin-top: 5px; margin-right: 5px; margin-bottom: 5px; margin-left: 5px; background-color: rgb(96, 96, 96);" />
        <ui:VisualElement name="bw-card-content" style="flex-grow: 1; margin-right: 15px; margin-left: 15px; margin-bottom: 10px;">
            <ui:Label tabindex="-1" text="Lorem ipsum dolor sit amet, consectetur adipiscing elit. , eu facilisis lectus. Lorem ipsum dolor sit amet, consectetur adipiscing elit. , eu facilisis lectus. Lorem ipsum dolor sit amet, consectetur adipiscing elit. , eu facilisis lectus." parse-escape-sequences="true" display-tooltip-when-elided="true" name="bw-card-description" style="color: rgb(202, 202, 202); -unity-text-align: upper-center; -unity-font-style: normal; font-size: 12px; white-space: normal; flex-shrink: 1; text-overflow: ellipsis;" />
        </ui:VisualElement>
        <ui:Button text="Create" parse-escape-sequences="true" display-tooltip-when-elided="true" name="bw-card-select-btn" style="color: rgb(202, 202, 202); background-color: rgb(89, 89, 89); border-top-left-radius: 10px; border-top-right-radius: 10px; border-bottom-right-radius: 10px; border-bottom-left-radius: 10px; padding-top: 3px; padding-right: 3px; padding-bottom: 3px; padding-left: 3px; width: 100%; flex-grow: 1;" />
    </ui:VisualElement>
</ui:UXML>
